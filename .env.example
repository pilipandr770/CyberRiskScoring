# risk-scanner (Module 1/2) configuration.
# Generate SESSION_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-string

# Session cookie is Secure by default (browser only sends it over https),
# which matches production (always behind Traefik/Cloudflare TLS). Local
# docker-compose dev over plain http://localhost:8000 must set this to
# "false" or the login cookie won't round-trip.
SESSION_COOKIE_SECURE=false

# Required for real scanning/report generation
SHODAN_API_KEY=
ANTHROPIC_API_KEY=

# Optional free-tier enrichment APIs — reserved for future use, app works without them
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
IPINFO_TOKEN=

# Local CVE cache (cvelistV5 sparse clone) — defaults are usually fine
CVE_CSV_REMOTE_URL=https://github.com/CVEProject/cvelistV5
CVE_CSV_REFRESH_HOURS=24
CVE_CVELIST_YEARS_BACK=8
CVE_CVELIST_MAX_ROWS=20000

# Insurer branding placeholder — becomes a per-tenant DB field later
INSURER_NAME=Ihre Cyber-Versicherung

# Machine API — Module 3 (nis2-store) calls this in place of the old
# external "black box" microservice. Generate with:
# python -c "import secrets; print(secrets.token_hex(24))"
M3_API_KEY=

# Outbound — called when an underwriter accepts a decision, to provision
# the client's account on Module 3. Must match nis2-store's
# M3_PROVISIONING_API_KEY.
M3_PROVISIONING_WEBHOOK_URL=http://nis2-store:5000/api/provisioning/webhook
M3_PROVISIONING_API_KEY=

# Shared Postgres password for the nis2-postgres service (docker-compose.yml)
NIS2_POSTGRES_PASSWORD=change-me

# Port bindings — override for a shared host to avoid colliding with other
# projects or exposing ports before Traefik/TLS is set up, e.g.:
#   RISK_SCANNER_PORT_MAPPING=127.0.0.1:8000:8000
#   NIS2_STORE_PORT_MAPPING=127.0.0.1:5010:5000
RISK_SCANNER_PORT_MAPPING=8000:8000
NIS2_STORE_PORT_MAPPING=5000:5000
